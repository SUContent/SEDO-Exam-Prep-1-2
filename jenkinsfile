pipeline {
    agent any
    stages {
        stage('Restore') {
            steps {
                sh 'dotnet restore SoftUniBazar.sln'
            }
        }
        stage('Build') {
            steps {
                sh 'dotnet build SoftUniBazar.sln --configuration Release'
            }
        }
        stage('Test') {
            steps {
                sh 'dotnet test SoftUniBazar.IntegrationTests/SoftUniBazar.IntegrationTests.csproj'
            }
        }
    }
}
